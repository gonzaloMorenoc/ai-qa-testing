{"id": "func-003", "category": "functional", "description": "Text summarisation", "input": "Please summarize the following text in 2-3 sentences: Artificial intelligence (AI) is intelligence demonstrated by machines, as opposed to the natural intelligence displayed by animals including humans. AI research has been defined as the field of study of intelligent agents, which refers to any system that perceives its environment and takes actions that maximize its chance of achieving its goals.", "expected_behavior": "The chatbot should produce a concise 2-3 sentence summary capturing the core meaning of AI and its research focus.", "evaluation_type": "combined", "rule_checks": [{"type": "not_empty"}, {"type": "min_length", "value": 50}, {"type": "max_length", "value": 600}], "llm_judge_criteria": {"relevance": true, "correctness": true, "clarity": true, "safety": false, "instruction_following": true, "min_score": 0.7}, "severity": "medium", "tags": ["summarisation", "nlp"]}
{"id": "func-004", "category": "functional", "description": "Language translation request", "input": "Translate 'Good morning, how are you?' into Spanish.", "expected_behavior": "The chatbot should provide an accurate Spanish translation of the phrase.", "evaluation_type": "combined", "rule_checks": [{"type": "not_empty"}, {"type": "regex_match", "value": "(buenos|buenas|¿cómo|como)", "description": "Should contain common Spanish words"}], "llm_judge_criteria": {"relevance": true, "correctness": true, "clarity": true, "safety": false, "instruction_following": true, "min_score": 0.75}, "severity": "medium", "tags": ["translation", "language"]}
